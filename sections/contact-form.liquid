{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} {
    --orca-contact-accent: {{ section.settings.accent | default: '#007979' }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign contact_email = section.settings.custom_email | default: shop.email -%}
{%- if contact_email == blank -%}
  {%- assign contact_email = 'info@ebin-stores.com' -%}
{%- endif -%}

<div class="orca-contact color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width isolate section-{{ section.id }}-padding">
    {%- if section.settings.show_email_only or section.blocks.size == 0 -%}
      <div class="orca-contact__card">
        {%- if section.settings.heading != blank -%}
          <h1 class="orca-contact__form-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h1 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h1>
        {%- endif -%}

        {%- if section.settings.sub_heading != blank -%}
          <div class="orca-contact__intro rte">{{ section.settings.sub_heading }}</div>
        {%- endif -%}

        <div class="orca-contact__mail-wrap">
          <a href="mailto:{{ contact_email }}" class="orca-contact__mail-link" aria-label="Email {{ contact_email }}">
            <svg class="orca-contact__mail-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{{ contact_email }}</span>
          </a>
        </div>
      </div>
    {%- else -%}
      {%- form 'contact', id: 'ContactForm', class: 'orca-contact__form' -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="orca-contact__form-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h1 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h1>
        {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="orca-contact__status orca-contact__status--success" tabindex="-1" autofocus>
          {% render 'icon-success' %}
          {{ 'templates.contact.form.post_success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="orca-contact__status orca-contact__status--error" role="alert" tabindex="-1" autofocus>
          <p>
            {% render 'icon-error' %}
            {{ 'templates.contact.form.error_heading' | t }}
          </p>
          <ul>
            <li>
              <a href="#ContactForm-email">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        </div>
      {%- endif -%}

      <div class="orca-contact__fields">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'name' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <input
                  class="field__input"
                  autocomplete="name"
                  type="text"
                  id="ContactForm-name"
                  name="contact[{{ 'templates.contact.form.name' | t }}]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.name' | t }}"
                >
                <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              </div>
            {%- when 'email' -%}
              <div class="field field--with-error orca-contact__email" {{ block.shopify_attributes }}>
                <input
                  autocomplete="email"
                  type="email"
                  id="ContactForm-email"
                  class="field__input"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="ContactForm-email-error"
                  {% endif %}
                  placeholder="{{ 'templates.contact.form.email' | t }}"
                >
                <label class="field__label" for="ContactForm-email">
                  {{- 'templates.contact.form.email' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                {%- if form.errors contains 'email' -%}
                  <small class="contact__field-error" id="ContactForm-email-error">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </span>
                  </small>
                {%- endif -%}
              </div>
            {%- when 'tel' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <input
                  type="tel"
                  id="ContactForm-phone"
                  class="field__input"
                  autocomplete="tel"
                  name="contact[{{ 'templates.contact.form.phone' | t }}]"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.phone' | t }}"
                >
                <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
              </div>
            {%- when 'date' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <input
                  type="date"
                  id="ContactForm-date"
                  class="field__input"
                  name="contact[date]"
                >
                <label class="field__label" for="ContactForm-date">Select your date</label>
              </div>
            {%- when 'select' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <select
                  class="field__input"
                  name="contact[{{ block.settings.select_id }}]"
                  id="ContactForm-select-{{ block.id }}"
                >
                  <option value="{{ block.settings.option_1 | escape }}">{{ block.settings.option_1 }}</option>
                  <option value="{{ block.settings.option_2 | escape }}">{{ block.settings.option_2 }}</option>
                  {%- if block.settings.show_option_3 -%}
                    <option value="{{ block.settings.option_3 | escape }}">{{ block.settings.option_3 }}</option>
                  {%- endif -%}
                  {%- if block.settings.show_option_4 -%}
                    <option value="{{ block.settings.option_4 | escape }}">{{ block.settings.option_4 }}</option>
                  {%- endif -%}
                </select>
                <label class="field__label" for="ContactForm-select-{{ block.id }}">{{ block.settings.option_label }}</label>
              </div>
            {%- when 'textarea' -%}
              <div class="field orca-contact__message" {{ block.shopify_attributes }}>
                <textarea
                  rows="6"
                  id="ContactForm-body"
                  class="text-area field__input"
                  name="contact[{{ 'templates.contact.form.comment' | t }}]"
                  placeholder="{{ 'templates.contact.form.comment' | t }}"
                >{{- form.body -}}</textarea>
                <label class="field__label" for="ContactForm-body">
                  {{- 'templates.contact.form.comment' | t -}}
                </label>
              </div>
            {%- when 'text' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <input
                  type="text"
                  id="ContactForm-text-{{ block.id }}"
                  name="contact[{{ block.settings.text }}]"
                  class="field__input"
                  placeholder="{{ block.settings.text_label }}"
                >
                <label class="field__label" for="ContactForm-text-{{ block.id }}">
                  {{ block.settings.text_label }}
                </label>
              </div>
          {%- endcase -%}
        {% endfor %}
      </div>

      <div class="orca-contact__actions">
        <button type="submit" class="orca-contact__submit">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .orca-contact {
    --orca-contact-accent: #007979;
  }

  .orca-contact__header {
    max-width: 46rem;
    margin: 0 auto 3.2rem;
    text-align: center;
  }

  .orca-contact__eyebrow {
    display: block;
    margin: 0 0 0.8rem;
    color: var(--orca-contact-accent, #007979);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .orca-contact__title {
    margin: 0;
    letter-spacing: -0.04em;
  }

  .orca-contact__intro {
    margin: 1rem 0 0;
    color: rgba(var(--color-foreground), 0.62);
    font-size: 1.6rem;
    line-height: 1.5;
  }

  .orca-contact__intro > *:first-child {
    margin-top: 0;
  }

  .orca-contact__intro > *:last-child {
    margin-bottom: 0;
  }

  .orca-contact__card,
  .orca-contact__form {
    max-width: 58rem;
    margin: 0 auto;
    padding: 3.6rem 2.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 28px;
    background: rgb(var(--color-background));
    box-shadow: 0 18px 40px rgba(var(--color-foreground), 0.06);
    text-align: center;
  }

  .orca-contact__mail-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.2rem;
  }

  .orca-contact__mail-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 1.5rem 3.2rem;
    border-radius: 999px;
    background: var(--orca-contact-accent, #007979);
    color: #ffffff !important;
    font-size: 1.65rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 121, 121, 0.22);
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    word-break: break-all;
  }

  .orca-contact__mail-link:hover,
  .orca-contact__mail-link:focus-visible {
    background: #24B1B1;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 121, 121, 0.32);
    color: #ffffff !important;
  }

  .orca-contact__mail-icon {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .orca-contact__form-title {
    margin: 0 0 1.6rem;
    letter-spacing: -0.04em;
    text-align: center;
  }

  .orca-contact__fields {
    display: grid;
    gap: 1.4rem;
  }

  .orca-contact__email,
  .orca-contact__message {
    grid-column: 1 / -1;
  }

  .orca-contact .field {
    margin: 0;
  }

  .orca-contact .field:before,
  .orca-contact .field:after {
    display: none;
  }

  .orca-contact .field__input,
  .orca-contact .field__input:hover,
  .orca-contact .field__input:focus,
  .orca-contact .text-area {
    min-height: 5.6rem;
    padding: 1.8rem 1.8rem 0.8rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 16px;
    background: rgba(var(--color-foreground), 0.035);
    box-shadow: none;
  }

  .orca-contact .text-area {
    min-height: 14rem;
    padding-top: 2.4rem;
    resize: vertical;
  }

  .orca-contact .field__input:focus {
    border-color: var(--orca-contact-accent, #007979);
    background: rgb(var(--color-background));
  }

  .orca-contact .field__label {
    left: 1.8rem;
    color: rgba(var(--color-foreground), 0.55);
  }

  .orca-contact__status {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 0 0 1.8rem;
    padding: 1.4rem 1.6rem;
    border-radius: 16px;
    font-size: 1.5rem;
  }

  .orca-contact__status--success {
    background: rgba(42, 91, 255, 0.08);
  }

  .orca-contact__status--error {
    background: rgba(var(--color-foreground), 0.05);
  }

  .orca-contact__status p,
  .orca-contact__status ul {
    margin: 0;
  }

  .orca-contact__actions {
    margin-top: 1.8rem;
  }

  .orca-contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    padding: 0 2.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--orca-contact-accent, #007979);
    color: #fff;
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
  }

  .orca-contact__submit:hover,
  .orca-contact__submit:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(42, 91, 255, 0.28);
  }

  @media screen and (min-width: 750px) {
    .orca-contact__form {
      padding: 3.2rem;
    }

    .orca-contact__fields {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.popup"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Get in touch",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text_alignment",
      "id": "heading_align",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "heading_align_mobile",
      "label": "Alignment – Mobile",
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "sub_heading",
      "default": "<p>Questions about an order or a product? Send a note and we’ll get back to you.</p>",
      "label": "Description"
    },
    {
      "type": "text_alignment",
      "id": "sub_heading_align",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "sub_heading_align_mobile",
      "label": "Alignment – Mobile",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_email_only",
      "label": "Show email only (no input fields)",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_email",
      "label": "Custom email",
      "default": "info@ebin-stores.com",
      "info": "Leave blank to use the store contact email."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#007979"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "name",
      "name": "Name",
      "limit": 1
    },
    {
      "type": "email",
      "limit": 1,
      "name": "Email"
    },
    {
      "type": "textarea",
      "limit": 1,
      "name": "Text Box"
    },
    {
      "type": "tel",
      "limit": 1,
      "name": "Telephone"
    },
    {
      "type": "date",
      "limit": 1,
      "name": "Date"
    },
    {
      "type": "text",
      "name": "Text field",
      "settings": [
        {
          "type": "text",
          "id": "text_label",
          "label": "Placeholder text",
          "default": "Write something"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Name",
          "default": "Text",
          "info": "Only you can see this when recieve form"
        }
      ]
    },
    {
      "type": "select",
      "name": "Dropdown",
      "settings": [
        {
          "type": "text",
          "id": "select_id",
          "label": "Name",
          "default": "select",
          "info": "Only you can see this when recieve form"
        },
        {
          "type": "text",
          "id": "option_label",
          "label": "Placeholder text",
          "default": "Select your option"
        },
        {
          "type": "text",
          "id": "option_1",
          "label": "Option 1",
          "default": "Option 1"
        },
        {
          "type": "text",
          "id": "option_2",
          "label": "Option 2",
          "default": "Option 2"
        },
        {
          "type": "checkbox",
          "id": "show_option_3",
          "default": false,
          "label": "Show Option 3"
        },
        {
          "type": "text",
          "id": "option_3",
          "label": "Option 3",
          "default": "Option 3"
        },
        {
          "type": "checkbox",
          "id": "show_option_4",
          "default": false,
          "label": "Show Option 4"
        },
        {
          "type": "text",
          "id": "option_4",
          "label": "Option 4",
          "default": "Option 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
      "blocks": [
        { "type": "name" },
        { "type": "email" },
        { "type": "tel" },
        { "type": "textarea" }
      ]
    }
  ]
}
{% endschema %}
