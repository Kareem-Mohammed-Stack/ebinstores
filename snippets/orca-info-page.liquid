{%- comment -%}
  Ebinstores - Store Information & About Us Component
  Can be rendered via section or snippet inside page templates.
{%- endcomment -%}

{%- assign badge = section.settings.badge | default: 'ABOUT EBIN STORES' -%}
{%- assign title = section.settings.title | default: 'Everyday products, chosen with care.' -%}
{%- assign description = section.settings.description | default: 'We curate practical, high-quality home, wellness, and lifestyle essentials designed to make everyday living simpler, healthier, and more enjoyable.' -%}

{%- assign stat_1_number = section.settings.stat_1_number | default: '50,000+' -%}
{%- assign stat_1_label = section.settings.stat_1_label | default: 'Happy Customers' -%}
{%- assign stat_2_number = section.settings.stat_2_number | default: '4.8 ★' -%}
{%- assign stat_2_label = section.settings.stat_2_label | default: 'Customer Satisfaction' -%}
{%- assign stat_4_number = section.settings.stat_4_number | default: '14-Day' -%}
{%- assign stat_4_label = section.settings.stat_4_label | default: 'Money-Back Guarantee' -%}

{%- assign story_eyebrow = section.settings.story_eyebrow | default: 'OUR STORY & MISSION' -%}
{%- assign story_heading = section.settings.story_heading | default: 'Crafted for Convenience, Built on Quality' -%}
{%- assign story_text = section.settings.story_text | default: 'At Ebinstores, we believe quality home, wellness, and lifestyle items shouldn’t come with exorbitant markups or questionable reliability. We curate functional products that solve real everyday problems and make daily routines feel effortless.' -%}

{%- assign quote_tag = section.settings.quote_tag | default: 'THE EBIN STANDARD' -%}
{%- assign quote_text = section.settings.quote_text | default: 'We don’t sell everything under the sun. We only offer products we would proudly use in our own homes.' -%}
{%- assign quote_author = section.settings.quote_author | default: 'The Ebinstores Team' -%}

{%- assign values_eyebrow = section.settings.values_eyebrow | default: 'WHY SHOP WITH US' -%}
{%- assign values_title = section.settings.values_title | default: 'Our Core Commitments to You' -%}
{%- assign values_subtitle = section.settings.values_subtitle | default: 'Here is what guides every decision we make from product curation to customer delivery.' -%}

{%- assign contact_eyebrow = section.settings.contact_eyebrow | default: 'NEED ASSISTANCE?' -%}
{%- assign contact_title = section.settings.contact_title | default: 'We’re Always Here Whenever You Need Us' -%}
{%- assign contact_desc = section.settings.contact_desc | default: 'Have questions about a product, delivery time, or an existing order? Get in touch with us anytime.' -%}
{%- assign contact_email = section.settings.contact_email | default: 'info@ebin-stores.com' -%}

<div class="orca-info-page">
  <!-- 1. Hero Section -->
  <section class="orca-info-hero page-width">
    {%- if badge != blank -%}
      <div class="orca-info-hero__badge">{{ badge | escape }}</div>
    {%- endif -%}
    {%- if title != blank -%}
      <h1 class="orca-info-hero__title">{{ title | escape }}</h1>
    {%- endif -%}
    {%- if description != blank -%}
      <p class="orca-info-hero__desc">{{ description | escape }}</p>
    {%- endif -%}
  </section>

  <!-- 2. Stats Strip -->
  <style>
    .orca-info-page .orca-info-stats__grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      width: 100%;
      max-width: 96rem;
      margin: 0 auto;
    }
    .orca-info-page .orca-info-stats__grid .orca-info-stat-card {
      flex: 1 1 24rem;
      max-width: 30rem;
    }
    @media screen and (max-width: 550px) {
      .orca-info-page .orca-info-stats__grid {
        gap: 1.2rem;
      }
      .orca-info-page .orca-info-stats__grid .orca-info-stat-card {
        flex-basis: 100%;
        max-width: none;
      }
    }
  </style>
  <section class="orca-info-stats page-width">
    <div class="orca-info-stats__grid">
      <div class="orca-info-stat-card">
        <span class="orca-info-stat-card__number">{{ stat_1_number | escape }}</span>
        <p class="orca-info-stat-card__label">{{ stat_1_label | escape }}</p>
      </div>
      <div class="orca-info-stat-card">
        <span class="orca-info-stat-card__number">{{ stat_2_number | escape }}</span>
        <p class="orca-info-stat-card__label">{{ stat_2_label | escape }}</p>
      </div>
      <div class="orca-info-stat-card">
        <span class="orca-info-stat-card__number">{{ stat_4_number | escape }}</span>
        <p class="orca-info-stat-card__label">{{ stat_4_label | escape }}</p>
      </div>
    </div>
  </section>

  <!-- 3. Brand Story & Mission -->
  <section class="orca-info-story page-width">
    <div class="orca-info-story__grid">
      <div class="orca-info-story__content">
        <div class="orca-info-story__eyebrow">{{ story_eyebrow | escape }}</div>
        <h2 class="orca-info-story__heading">{{ story_heading | escape }}</h2>
        <p class="orca-info-story__text">{{ story_text | escape }}</p>
        <ul class="orca-info-story__bullets">
          <li class="orca-info-story__bullet">
            <span class="orca-info-story__bullet-icon">✓</span>
            <span><strong>Carefully Vetted Catalog:</strong> Every item is tested for safety, durability, and practical everyday use before it reaches our catalog.</span>
          </li>
          <li class="orca-info-story__bullet">
            <span class="orca-info-story__bullet-icon">✓</span>
            <span><strong>Transparent Value:</strong> Sourcing directly from verified partners means premium quality without inflated retail markups.</span>
          </li>
          <li class="orca-info-story__bullet">
            <span class="orca-info-story__bullet-icon">✓</span>
            <span><strong>Real Human Support:</strong> No endless bot loops. If you have questions about your order, our dedicated team responds within 24 hours.</span>
          </li>
        </ul>
      </div>

      <div class="orca-info-story__media">
        <div class="orca-info-story__media-card">
          <div class="orca-info-story__media-tag">{{ quote_tag | escape }}</div>
          <p class="orca-info-story__media-quote">“{{ quote_text | escape }}”</p>
          <p class="orca-info-story__media-author">— {{ quote_author | escape }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Core Values Grid -->
  <section class="orca-info-values">
    <div class="page-width">
      <div class="orca-info-values__header">
        <div class="orca-info-values__eyebrow">{{ values_eyebrow | escape }}</div>
        <h2 class="orca-info-values__title">{{ values_title | escape }}</h2>
        <p class="orca-info-values__subtitle">{{ values_subtitle | escape }}</p>
      </div>

      <div class="orca-info-values__grid">
        <div class="orca-info-value-card">
          <div class="orca-info-value-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h3 class="orca-info-value-card__heading">100% Quality Inspected</h3>
          <p class="orca-info-value-card__desc">Each item is rigorously tested to ensure performance, safety, and durability meet our strict store standards before dispatch.</p>
        </div>

        <div class="orca-info-value-card">
          <div class="orca-info-value-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <h3 class="orca-info-value-card__heading">Tracked Reliable Shipping</h3>
          <p class="orca-info-value-card__desc">Orders are prepared and dispatched swiftly with full end-to-end tracking links sent straight to your inbox.</p>
        </div>

        <div class="orca-info-value-card">
          <div class="orca-info-value-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
          </div>
          <h3 class="orca-info-value-card__heading">14-Day Hassle-Free Returns</h3>
          <p class="orca-info-value-card__desc">We stand behind every product. If you are not completely delighted with your order, return it easily within 14 days for a refund.</p>
        </div>

        <div class="orca-info-value-card">
          <div class="orca-info-value-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </div>
          <h3 class="orca-info-value-card__heading">Dedicated Customer Care</h3>
          <p class="orca-info-value-card__desc">Questions, feedback, or need help tracking an order? Reach our customer care team anytime at {{ contact_email | escape }}.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Contact & Support Callout -->
  <section class="orca-info-contact page-width">
    <div class="orca-info-contact__card">
      <div class="orca-info-contact__eyebrow">{{ contact_eyebrow | escape }}</div>
      <h2 class="orca-info-contact__title">{{ contact_title | escape }}</h2>
      <p class="orca-info-contact__desc">{{ contact_desc | escape }}</p>
      <div class="orca-info-contact__actions">
        <a href="mailto:{{ contact_email | escape }}" class="orca-info-btn orca-info-btn--primary">
          Email Us: {{ contact_email | escape }}
        </a>
        <a href="/pages/order-tracking" class="orca-info-btn orca-info-btn--outline">
          Track Your Order
        </a>
        <a href="/pages/contact" class="orca-info-btn orca-info-btn--outline">
          Contact Form
        </a>
      </div>
    </div>
  </section>
</div>
